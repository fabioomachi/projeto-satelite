# Projeto Satélite — template de configuração.
# Copie para `.env` e preencha com os dados reais das suas câmeras:
#   cp .env.example .env
# O arquivo `.env` está no .gitignore e nunca deve ser commitado.
#
# Variáveis de ambiente reais do SO têm precedência sobre o `.env`.
# Para adicionar câmeras, crie blocos CAM_2_*, CAM_3_*, ... e ajuste CAM_COUNT.

# Transporte RTSP do FFmpeg/OpenCV (udp ou tcp, conforme sua câmera).
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;udp

# Quantidade de câmeras configuradas abaixo.
CAM_COUNT=1

# --- Câmera 1 ---
CAM_1_ID=cam1
CAM_1_IP=192.168.x.x
CAM_1_PORT=554
CAM_1_USER=admin
CAM_1_PASSWORD=troque-aqui
CAM_1_CHANNEL=/onvif1

# --- Câmera 2 (exemplo, descomente e ajuste CAM_COUNT=2 para usar) ---
# CAM_2_ID=cam2
# CAM_2_IP=192.168.x.x
# CAM_2_PORT=554
# CAM_2_USER=admin
# CAM_2_PASSWORD=troque-aqui
# CAM_2_CHANNEL=/onvif1

# --- Sentinela (detector de movimento, CPU) ---
# Amostras por segundo do fundo adaptativo (1.0 ou 2.0).
SENTINEL_FPS=1.0
# Resolução interna: 160x120 ~= 19 mil pixels (microssegundos no Ryzen 3).
SENTINEL_WIDTH=160
SENTINEL_HEIGHT=120
# Intensidade mínima (0-255) para um pixel contar como "mudou".
SENTINEL_THRESHOLD=25
# Fração de pixels alterados que caracteriza movimento (0.02 = 2%).
SENTINEL_MOTION_RATIO=0.02
# Positivos seguidos para LIGAR (rejeita spikes de ruído H.264).
SENTINEL_MIN_FRAMES=2
# Segundos sem movimento até DESLIGAR.
SENTINEL_COOLDOWN_S=3.0
# Velocidade de aprendizado do fundo (absorve sol/nuvem devagar).
SENTINEL_BG_ALPHA=0.05
